{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes Rust",
  "version": "0.1.0",
  "identifier": "dev.notes.rust",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notes Rust",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#252525"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https: blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src ipc: http://ipc.localhost http://127.0.0.1:49325 https:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ],
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "targets": "all",
    "icon": [
      "../public/favicon/app-icon-512.png",
      "../public/favicon/favicon.ico"
    ],
    "category": "Productivity"
  }
}
