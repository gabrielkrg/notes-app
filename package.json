{
  "name": "notes",
  "productName": "Notes",
  "desktopName": "notes-desk",
  "description": "A local markdown notes reader.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --config browser/vite.config.ts",
    "build": "tsc --noEmit && vite build --config browser/vite.config.ts",
    "preview": "vite preview --config browser/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test browser/src/lib/*.test.ts browser/src/content-core.test.ts browser/src/annotations.test.ts",
    "desktop": "env -u ELECTRON_RUN_AS_NODE ELECTRON=1 vite --config desktop/vite.config.ts",
    "desktop:pack": "tsc --noEmit && ELECTRON=1 vite build --config desktop/vite.config.ts",
    "desktop:build": "npm run desktop:pack && env -u ELECTRON_RUN_AS_NODE electron-builder --linux AppImage",
    "desktop:build:linux": "npm run desktop:pack && env -u ELECTRON_RUN_AS_NODE electron-builder --linux AppImage",
    "desktop:build:win": "npm run desktop:pack && env -u ELECTRON_RUN_AS_NODE electron-builder --win nsis",
    "desktop:build:mac": "npm run desktop:pack && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vite-plugin-electron": "^0.29.1"
  },
  "build": {
    "appId": "dev.notes.desk",
    "productName": "Notes",
    "icon": "browser/public/favicon/favicon-96x96.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "notes",
        "to": "notes"
      }
    ],
    "linux": {
      "icon": "browser/public/favicon/favicon-96x96.png",
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
