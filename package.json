{
  "name": "notes",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "preview": "npm run preview -w app",
    "typecheck": "npm run typecheck -w app",
    "test": "npm run test -w app",
    "desktop": "npm --prefix rust-app run dev",
    "desktop:pack": "npm --prefix rust-app run build -- --no-bundle",
    "desktop:build": "npm --prefix rust-app run build",
    "desktop:build:linux": "npm --prefix rust-app run build -- --bundles appimage",
    "desktop:build:win": "npm --prefix rust-app run build -- --bundles nsis",
    "desktop:build:mac": "npm --prefix rust-app run build -- --bundles dmg",
    "mobile": "npm run mobile -w app",
    "mobile:build": "npm run mobile:build -w app",
    "mobile:sync": "npm run mobile:sync -w app",
    "mobile:android": "npm run mobile:android -w app",
    "mobile:run:android": "npm run mobile:run:android -w app",
    "mobile:assets": "npm run mobile:assets -w app",
    "mobile:build:android": "npm run mobile:build:android -w app",
    "desktop:test": "npm --prefix rust-app test",
    "desktop:typecheck": "npm --prefix rust-app run typecheck"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
