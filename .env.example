# Copy to .env and adjust for this machine.
# Vite exposes VITE_* to the browser app.

# Absolute path to the notes folder, or several paths separated by commas.
# Used for the file tree and "Open file" links.
# If unset, defaults to <this-repo>/notes.
# Restart the dev server after changing this.
VITE_NOTES_ROOT=/absolute/path/to/notes
# VITE_NOTES_ROOT=/absolute/path/to/notes,/absolute/path/to/other

# Editor URL scheme prepended to that path.
# Example: cursor://file/absolute/path/to/notes/php/arrays.md
VITE_EDITOR_PROTOCOL=cursor://file

# Browser localStorage prefix (done, last, theme, annotations).
VITE_STORAGE_PREFIX=notes

# Vite dev server port.
VITE_DEV_PORT=5173

# Editor for Vite's error overlay "open in editor".
LAUNCH_EDITOR=cursor
